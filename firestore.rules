rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAllowedErpDocId(docId) {
      return docId in [
        'identitas',
        'mutasi',
        'salur_orders',
        'donasi_orders',
        'transaksi_ajar',
        'pengeluaran',
        'pos_keuangan',
        'coa_accounts',
        'projects',
        'organisasi',
        'dharma_patron_rutin',
        'central_audit_logs',
        'merge_session_records',
        'identitas_change_logs',
        'rbac_permissions',
        'member_accounts',
        'login_activity_logs',
        'sapa_coverage_zones',
        'cuti_karyawan',
        'stok_salur_items',
        'gudang_salur_data',
        'stock_in_out_salur',
        'lokasi_stok_salur',
        'jenis_perubahan_salur',
        'connection_test'
      ];
    }

    function isValidErpEntity(data, docId) {
      return data.keys().hasAll(['id', 'updatedAt'])
        && data.keys().hasOnly(['id', 'updatedAt', 'items', 'data'])
        && isValidId(data.id)
        && data.id == docId
        && data.updatedAt is string
        && data.updatedAt.size() >= 10
        && data.updatedAt.size() <= 64
        && (
          !data.keys().hasAny(['items']) ||
          (data.items is list && data.items.size() <= 1500 && (data.items.size() == 0 || data.items[0] is map))
        )
        && (
          !data.keys().hasAny(['data']) ||
          (data.data is string && data.data.size() <= 500000)
        );
    }

    match /erp_state/{docId} {
      allow get: if isValidId(docId) && isAllowedErpDocId(docId);
      allow list: if false;
      allow create: if isValidId(docId)
        && isAllowedErpDocId(docId)
        && isValidErpEntity(incoming(), docId);
      allow update: if isValidId(docId)
        && isAllowedErpDocId(docId)
        && isValidErpEntity(incoming(), docId)
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'items', 'data']);
      allow delete: if false;
    }
  }
}
